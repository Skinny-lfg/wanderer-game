{
  "name": "wanderer-game",
  "private": true,
  "type": "module",
  "scripts": {
    "build:firebase": "esbuild online/firebase-sdk-source.mjs --bundle --format=esm --minify --outfile=online/vendor/firebase-sdk.mjs",
    "test": "node tests/phase2-smoke.cjs && node tests/online-save-compat.cjs && node --test tests/online-model.test.mjs tests/profile-restore.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-wanderer 'node --test tests/firestore-rules.test.mjs'",
    "test:browser": "node tests/online-browser.cjs"
  },
  "dependencies": {
    "firebase": "11.10.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "esbuild": "0.25.5",
    "firebase-tools": "14.7.0",
    "playwright": "1.56.1"
  }
}
