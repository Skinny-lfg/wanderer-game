rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Development v0.10.1: only registered, verified player identities are writable.
  function verifiedPlayer() {
   // Fail closed for anonymous, custom or missing providers.
   // Firebase Auth sets the provider claim in signed ID tokens.
   let provider = request.auth != null
     ? request.auth.token.get('firebase', {}).get('sign_in_provider', '') : '';
   return request.auth != null && (
     provider == 'google.com' ||
     (provider == 'password' && request.auth.token.get('email_verified', false) == true)
   );
  }
  function owner(uid) { return verifiedPlayer() && request.auth.uid == uid; }
  function character(id) { return id in ['wanderer','ranger','knight','spellblade','duelist']; }
  function validProfile(d) { return d.keys().hasOnly(['nickname','characterId','createdAt','updatedAt']) && d.nickname is string && d.nickname.matches('^[a-z0-9_]{3,20}$') && character(d.characterId) && d.createdAt is timestamp && d.updatedAt == request.time; }
  function hasProfile(uid) { return exists(/databases/$(database)/documents/publicProfiles/$(uid)); }
  match /nicknames/{nickname} {
   allow get: if verifiedPlayer();
   allow list: if false;
   allow create: if verifiedPlayer() && nickname.matches('^[a-z0-9_]{3,20}$') && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
    && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.nickname == nickname;
   allow update, delete: if false;
  }
  match /publicProfiles/{uid} {
   allow get: if true;
   allow list: if false;
   allow create: if owner(uid) && validProfile(request.resource.data) && request.resource.data.createdAt == request.time
    && getAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.nickname)).data.uid == uid;
   allow update: if owner(uid) && validProfile(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['characterId','updatedAt']);
   allow delete: if false;
  }
  // Fresh v0.9.2 saves. Old /saves/current is rejected by default.
  match /players/{uid}/saves/v092 {
   function validSave() { let d=request.resource.data; return d.keys().hasOnly(['payload','revision','schemaVersion','updatedAt']) && d.payload is string && d.payload.size() <= 700000 && d.revision is int && d.schemaVersion == 1 && d.updatedAt == request.time; }
   allow read: if owner(uid);
   allow create: if owner(uid) && hasProfile(uid) && validSave() && request.resource.data.revision == 1;
   allow update: if owner(uid) && hasProfile(uid) && validSave() && request.resource.data.revision == resource.data.revision + 1;
   allow delete: if false;
  }
  // v0.12 starts a separate Expedition progression; Guest saves are private and owner-bound.
  match /players/{uid}/saves/v012 {
   function saveIdentity() { return request.auth != null && request.auth.uid == uid; }
   function validV012() { let d=request.resource.data; return d.keys().hasOnly(['payload','revision','schemaVersion','format','createdAt','updatedAt']) && d.keys().hasAll(['payload','revision','schemaVersion','format','createdAt','updatedAt']) && d.payload is string && d.payload.size() <= 700000 && d.revision is int && d.revision >= 1 && d.schemaVersion == 13 && d.format == 'wanderer-expedition' && d.createdAt is timestamp && d.updatedAt == request.time; }
   allow read: if saveIdentity();
   allow create: if saveIdentity() && validV012() && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time;
   allow update: if saveIdentity() && validV012() && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.revision == resource.data.revision + 1;
   allow delete: if false;
  }
  // Old public equipment is no longer readable; a fresh collection is used.
  match /publicLoadoutsV092/{uid} {
   allow get: if verifiedPlayer();
   allow list: if false;
   allow create, update: if owner(uid) && hasProfile(uid)
    && request.resource.data.keys().hasOnly(['equipment','maxDungeon','updatedAt'])
    && request.resource.data.equipment is string && request.resource.data.equipment.size() <= 30000
    && request.resource.data.maxDungeon is int && request.resource.data.maxDungeon >= 1 && request.resource.data.maxDungeon <= 200
    && request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
  // Community scores remain client-submitted (UNVERIFIED). Server-verified runs need a trusted backend.
  match /testSeasons/v092-launch-1/deepest/{uid} {
   function validClaim() {
    let d=request.resource.data;
    return d.keys().hasOnly(['deepest','attemptId','verified','updatedAt'])
     && d.keys().hasAll(['deepest','attemptId','verified','updatedAt'])
     && d.deepest is int && d.deepest >= 0 && d.deepest <= 200
     && d.attemptId is string && d.attemptId.size() >= 1 && d.attemptId.size() <= 100
     && d.attemptId.matches('^[A-Za-z0-9_-]+$')
     && d.verified == false && d.updatedAt == request.time;
   }
   allow read: if true;
   allow create: if owner(uid) && hasProfile(uid) && validClaim();
   allow update: if owner(uid) && hasProfile(uid) && validClaim()
    && (request.resource.data.attemptId != resource.data.get('attemptId','legacy')
     || request.resource.data.deepest >= resource.data.deepest);
   allow delete: if false;
  }
  // Combat-only fastest D200 records; old speedruns are denied by fallback.
  match /testSeasons/v092-launch-1/combatSpeedruns/{uid} {
   function validSpeedrun() {
    let d=request.resource.data;
    return d.keys().hasOnly(['bestMs','verified','updatedAt'])
     && d.keys().hasAll(['bestMs','verified','updatedAt'])
     && d.bestMs is int && d.bestMs >= 0 && d.bestMs <= 315360000000
     && d.verified == false && d.updatedAt == request.time;
   }
   allow read: if true;
   allow create: if owner(uid) && hasProfile(uid) && validSpeedrun();
   allow update: if owner(uid) && hasProfile(uid) && validSpeedrun()
    && request.resource.data.bestMs <= resource.data.bestMs;
   allow delete: if false;
  }
  // Retired milestones and old seasons cannot be read or written by the app.
  match /testSeasons/v092-launch-1/milestones/{milestone}/entries/{uid} {
   allow read, write: if false;
  }
  // Signed-in playtesters may create feedback; only a trusted administrator may read/export it.
  match /feedbackInbox/{feedbackId} {
   function validFeedback(d) {
    return d.keys().hasOnly(['uid','category','rating','combat','difficulty','likes','problems','ideas','maxDungeon','characterId','appVersion','createdAt'])
     && d.keys().hasAll(['uid','category','rating','combat','difficulty','likes','problems','ideas','maxDungeon','characterId','appVersion','createdAt'])
     && d.uid == request.auth.uid
     && d.category in ['general','bug','idea','balance']
     && d.rating is int && d.rating >= 0 && d.rating <= 5
     && d.combat in ['not-sure','great','okay','repetitive','confusing']
     && d.difficulty in ['not-sure','easy','balanced','hard']
     && d.likes is string && d.likes.size() <= 500
     && d.problems is string && d.problems.size() <= 1500
     && d.ideas is string && d.ideas.size() <= 1200
     && (d.likes.size() + d.problems.size() + d.ideas.size()) >= 10
     && d.maxDungeon is int && d.maxDungeon >= 1 && d.maxDungeon <= 200
     && character(d.characterId)
     && d.appVersion in ['0.8.1','0.9','0.9.2','0.10.1','0.11.0','0.12.0']
     && d.createdAt == request.time;
   }
   allow create: if verifiedPlayer() && hasProfile(request.auth.uid)
    && feedbackId.size() <= 170 && validFeedback(request.resource.data);
   allow get, list, update, delete: if false;
  }
  match /feedbackInboxV012/{feedbackId} {
   function validV012Feedback(d) { return d.keys().hasOnly(['uid','category','description','steps','appVersion','commit','screen','viewport','browser','technical','createdAt']) && d.keys().hasAll(['uid','category','description','steps','appVersion','commit','screen','viewport','browser','technical','createdAt']) && d.uid == request.auth.uid && d.category in ['bug','idea','balance','general'] && d.description is string && d.description.size() >= 10 && d.description.size() <= 1400 && d.steps is string && d.steps.size() <= 1150 && d.appVersion == '0.12.0' && d.commit is string && d.commit.size() <= 20 && d.screen is string && d.screen.size() <= 60 && d.viewport is string && d.viewport.size() <= 40 && d.browser is string && d.browser.size() <= 260 && d.technical is string && d.technical.size() <= 600 && d.createdAt == request.time; }
   allow create: if request.auth != null && feedbackId.matches('^[A-Za-z0-9_-]{1,170}$') && validV012Feedback(request.resource.data) && existsAfter(/databases/$(database)/documents/feedbackRateLimits/$(request.auth.uid)) && getAfter(/databases/$(database)/documents/feedbackRateLimits/$(request.auth.uid)).data.updatedAt == request.time;
   allow read, update, delete: if false;
  }
  match /feedbackRateLimits/{uid} {
   allow get: if request.auth != null && request.auth.uid == uid;
   allow list, delete: if false;
   allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['uid','updatedAt']) && request.resource.data.uid == uid && request.resource.data.updatedAt == request.time;
   allow update: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['uid','updatedAt']) && request.resource.data.uid == uid && request.resource.data.updatedAt == request.time && request.time >= resource.data.updatedAt + duration.value(60,'s');
  }
  // Only a future trusted backend using Admin SDK may write this separate namespace.
  match /verifiedSeasons/{document=**} { allow read, write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
